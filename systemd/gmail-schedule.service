[Unit]
Description=Project Gmail scheduling mail into the local calendar store
After=legion-messages.service

[Service]
Type=oneshot
ExecStart=%h/.local/share/fnm/node-versions/v24.14.0/installation/bin/node %h/.claude/plugins/local/legion-plugins/plugins/claude-messages/server/build/gmail-schedule.mjs
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.claude/local/calendar
